# /etc/systemd/system/harelphotos.service
#
#   systemctl daemon-reload
#   systemctl enable --now harelphotos
#   systemctl status harelphotos
#   journalctl -u harelphotos -f
#
# Edit User= and the two paths. --workers 2 suits a machine with about a
# gigabyte; see INSTALL.md for what workers and threads actually cost.

[Unit]
Description=harelphotos
After=network.target

[Service]
# Runs as the user who owns the photos: they stay where they are, in a home
# directory, and nothing needs to be moved or re-owned. Only the *generated*
# tree lives outside, under /var/lib/harelphotos, which also keeps a writable
# directory out of the home tree that ProtectHome= locks down below.
User=nyh
Group=nyh

Environment=HARELPHOTOS_CONFIG=/etc/harelphotos/config.toml

# Deliberately NOT the source tree. The config search order begins with the
# relative path `config.toml`, so a service whose working directory is a
# checkout will load that checkout's development config -- different
# photo_root, different index, different secret key -- the moment the line
# above is removed or mistyped. It would not fail; it would quietly serve the
# wrong album. Pointing here keeps gunicorn's sys.path fallback for an
# uninstalled checkout while leaving nothing for that first search entry to
# find.
WorkingDirectory=/var/lib/harelphotos

# --threads is the setting that matters here, not --workers.
#
# An album page is one HTML request followed by hundreds of image requests, and
# a browser issues many of them at once. With synchronous workers only
# `--workers` requests are served at a time and the rest queue: measured on a
# 381-photo album with 3 workers and 12 parallel requests, 48 of 60 images
# returned in 0.44s and the other 12 hung until the 120s timeout killed their
# worker. That is the "some photos never load, then appear a minute later"
# symptom exactly.
#
# Threads suit this workload precisely. An image request is an access check
# and then a file copied to a socket, and the copying releases the GIL while it
# waits on the disk and the network -- so threads overlap where it matters and
# contend only for the small Python part. 2 x 8 = 16 concurrent requests.
#
# --workers is the memory knob, not --threads. Measured with warmed processes,
# counting PSS: 24 threads cost about a megabyte more than one, because they
# share a single interpreter and one copy of Flask and Pillow. A worker is a
# whole separate Python, at roughly 29 MB. Two workers is ~82 MB, which suits a
# machine with a gigabyte; raise it if there is memory to spare, and go to one
# if there is not. The second worker buys resilience -- one dying does not take
# the site down -- rather than throughput, which is Apache's job here.
#
# --timeout 120: the first request for a WebP or JPEG fallback transcodes on
# demand, and on a slow machine a large image can take a while. Every request
# after it is a static file.
ExecStart=/home/nyh/harelphotos/.venv/bin/gunicorn \
    --workers 2 \
    --threads 8 \
    --worker-class gthread \
    --timeout 120 \
    --graceful-timeout 10 \
    --bind 127.0.0.1:8099 \
    --error-logfile - \
    harelphotos.wsgi:app

ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=2

# Bound how long a restart can take.
#
# On SIGTERM gunicorn stops accepting and waits for requests already in flight
# to finish -- up to --graceful-timeout (10s above, down from its default 30),
# and then systemd waits again on its own default of 90s before resorting to
# SIGKILL. With 8 threads per worker there are more requests in flight to wait
# for, so a restart under load can sit there noticeably longer than it used to.
# Nothing here is precious enough to wait a minute and a half for: the index is
# read-only to this process, so a killed request costs one refresh.
TimeoutStopSec=20

# Hardening. The service only ever reads the photos, and writes nothing
# outside its state directory, so it can be locked down hard.
#
# ProtectHome=read-only still lets it read the photos; ReadWritePaths then
# punches through it for the one directory that must be writable (auth.sqlite,
# and the on-demand WebP/JPEG fallback cache).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/var/lib/harelphotos

[Install]
WantedBy=multi-user.target
