# /etc/systemd/system/harelphotos.service
#
#   systemctl daemon-reload
#   systemctl enable --now harelphotos
#   systemctl status harelphotos
#   journalctl -u harelphotos -f
#
# Edit User=, the two paths, and --workers. See INSTALL.md.

[Unit]
Description=harelphotos
After=network.target

[Service]
User=harelphotos
Group=harelphotos

Environment=HARELPHOTOS_CONFIG=/etc/harelphotos/config.toml
WorkingDirectory=/srv/harelphotos

# --workers: this machine is CPU-weak and the workers do almost no CPU work
# (Apache sends the image bytes via X-Sendfile), so a small number is right.
# 3 is a reasonable start for 2 cores; raise it only if requests queue.
#
# --timeout 120: the first request for a WebP or JPEG fallback transcodes on
# demand, and on a slow machine a large image can take a while. Every request
# after it is a static file.
ExecStart=/srv/harelphotos/venv/bin/gunicorn \
    --workers 3 \
    --timeout 120 \
    --bind 127.0.0.1:8099 \
    --access-logfile - \
    --error-logfile - \
    harelphotos.wsgi:app

ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=2

# Hardening. The service reads photos and writes nothing outside its state
# directory, so it can be locked down hard. ReadWritePaths must list the state
# directory (index.sqlite, auth.sqlite and the generated images).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/var/lib/harelphotos

[Install]
WantedBy=multi-user.target
